# Copy this file to .env and fill in real values. Never commit .env.

# Provider order is configurable. Only providers with keys are enabled.
MODEL_PROVIDER_ORDER=anthropic,anthropic_secondary,anthropic_tertiary

# Primary Anthropic provider. This key is for this app only - do not reuse
# the global ANTHROPIC_API_KEY used by Claude Code (see SPEC.md section 2).
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Optional failover providers. Leave unset unless you have separate keys.
ANTHROPIC_SECONDARY_API_KEY=
ANTHROPIC_SECONDARY_MODEL=claude-sonnet-5
ANTHROPIC_TERTIARY_API_KEY=
ANTHROPIC_TERTIARY_MODEL=claude-sonnet-5

# Local SQLite database paths used by the production retrieval registry.
APP_DB_PATH=data/app.db
APP_COURSE_DB_PATH=data/course_data.db
