# Copy this file to .env and fill in real values. Never commit .env.
# This key is for this app only - do not reuse the global ANTHROPIC_API_KEY
# used by Claude Code (see SPEC.md section 2).
ANTHROPIC_API_KEY=your-api-key-here

# Local SQLite database path used by index/build_fts.py, index/build_courses.py,
# tools/text_tools.py, tools/course_tools.py.
APP_DB_PATH=data/app.db
